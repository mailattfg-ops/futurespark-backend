datasource db {
  provider = "postgresql"
  url      = env("INTEGRATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

model IntegrationConfig {
  id           String   @id @default(uuid())
  providerName String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model GoogleAccount {
  id             String    @id @default(uuid())
  workspaceEmail String    @unique
  accessToken    String
  refreshToken   String
  tokenExpiry    DateTime
  connected      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ZoomAccount {
  id             String    @id @default(uuid())
  accountEmail   String    @unique
  accountType    String    @default("SERVER_TO_SERVER") // "SERVER_TO_SERVER" | "OAUTH"
  accountId      String?
  clientId       String?
  clientSecret   String?
  accessToken    String?
  refreshToken   String?
  tokenExpiry    DateTime?
  connected      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// One purchased Zoom seat, managed from the admin UI.
///
/// This replaces ZOOM_HOST_EMAILS as the source of the host pool, so buying a
/// licence no longer needs an env edit and a redeploy. It lives in the
/// integration database — not auth — because the allocator reads the seat list
/// inside the same transaction as the overlap check (see meetings.service.ts);
/// a cross-database read could not give that guarantee.
///
/// `email` is the identity: it is what Zoom's API is called with and what
/// `Meeting.zoomHostEmail` records, so allocation still works for every meeting
/// booked before this table existed.
model ZoomHost {
  id          String   @id @default(uuid())
  name        String
  /// Stored lowercased. The unique index is what stops the same seat being
  /// added twice under different capitalisation and appearing to double the
  /// number of concurrent classes the pool can run.
  email       String   @unique
  /// "PRO" (licensed, can host a full class) or "BASIC" (40-minute cap).
  licenseType String   @default("PRO")
  /// Inactive seats are skipped by the allocator. Meetings already booked on
  /// them are untouched — the room still works, it just receives nothing new.
  active      Boolean  @default(true)
  /// Set when Zoom confirmed this address. Null = never checked, which is the
  /// normal state until the account is granted the user-read scope.
  verifiedAt   DateTime?
  /// What Zoom said the last time it was asked: "PRO" | "BASIC" | "NOT_FOUND"
  /// | "PENDING" (invitation not accepted yet, so it cannot host).
  verifiedType String?
  /// Why the last verification failed, for the admin to act on.
  lastError    String?
  /// Which seats were seeded from ZOOM_HOST_EMAILS during the cutover, so the
  /// difference between "an admin added this" and "the migration did" survives.
  source      String   @default("ADMIN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meetings    Meeting[]

  @@index([active])
}

model Meeting {
  id                 String             @id @default(uuid())
  provider           String             @default("GOOGLE_MEET") // "GOOGLE_MEET" | "ZOOM"
  calendarEventId    String?            @unique
  conferenceId       String?
  zoomMeetingId      String?            @unique
  zoomJoinUrl        String?
  zoomStartUrl       String?
  zoomPasscode       String?
  /// The seat this meeting was allocated. `zoomHostEmail` stays the source of
  /// truth for allocation (every historical row has it, and Zoom is called with
  /// it); `zoomHostId` is the join that makes "which host is busy right now"
  /// answerable without matching on strings. Null for meetings booked before
  /// the seat table existed, and for a mentor-hosted meeting whose address is
  /// not a pool seat.
  zoomHostId         String?
  zoomHost           ZoomHost?          @relation(fields: [zoomHostId], references: [id], onDelete: SetNull)
  zoomHostEmail      String?
  meetUrl            String
  title              String
  description        String?
  organizerEmail     String
  teacherId          String
  studentId          String
  programId          String
  sessionId          String
  startTime          DateTime
  endTime            DateTime
  timezone           String
  status             String             @default("SCHEDULED") // "SCHEDULED", "ACTIVE", "COMPLETED", "CANCELLED"
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  recordings         MeetingRecording[]

  // ── Post-class recording hunt ────────────────────────────────────────────
  // Stamped by auth-service when the MENTOR marks the class complete. The Drive
  // sweep will not look for a recording until this is set and old enough (see
  // RECORDING_SEARCH_DELAY_MINUTES) — Google publishes a Meet recording to Drive
  // 10-30 minutes after the call ends, and searching before then is pure quota
  // burn: the old sweep asked Drive every 2 minutes for 48 hours per meeting.
  classCompletedAt    DateTime?
  // How many times the sweep has searched Drive for this meeting, so a class
  // that was genuinely never recorded gives up instead of retrying forever.
  recordingSearches   Int       @default(0)
  recordingSearchedAt DateTime?

  // ── Live presence (Google Meet spaces.activeConference or Zoom live status) ──
  presenceIsLive      Boolean   @default(false)
  presenceFirstJoinAt DateTime?
  presenceLastLiveAt  DateTime?
  presenceCheckedAt   DateTime?
}

model MeetingRecording {
  id                   String   @id @default(uuid())
  meetingId            String
  meeting              Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  driveFileId          String?  @unique
  zoomRecordingId      String?  @unique
  fileName             String
  fileSize             Int
  duration             Int?     // Duration in seconds
  downloadUrl          String?
  playUrl              String?
  videoPath            String?  // Local/storage path for download
  audioPath            String?  // Local/storage path for extracted audio
  downloadStatus       String   @default("PENDING") // "PENDING", "COMPLETED", "FAILED"
  extractedAudioStatus String   @default("PENDING") // "PENDING", "COMPLETED", "FAILED"

  // ── Transcription lifecycle ──────────────────────────────────────────────
  // Tracked separately from the two statuses above because transcription is
  // the step that can fail for reasons that FIX THEMSELVES: the Groq free tier
  // allows 28,800 audio-seconds a day and 7,200 an hour, so the sixth class of
  // a day is rejected purely for arriving too soon.
  //
  // Without this the sweep never looked at such a class again — it selects
  // meetings whose recordings are still `pending_` placeholders, and by
  // transcription time the real Drive file is already linked. One 429 meant no
  // summary, ever, and 72 hours later the report cron mislabelled it
  // "[NO_RECORDING]" for a recording that had downloaded perfectly.
  transcriptionStatus  String   @default("PENDING") // "PENDING", "COMPLETED", "FAILED"
  transcriptionAttempts Int     @default(0)
  transcriptionError   String?
  /// Earliest sensible retry. Set an hour out for an hourly cap, tomorrow for a
  /// daily one — retrying a quota failure immediately just burns the quota.
  transcriptionRetryAt DateTime?

  createdAt            DateTime @default(now())
}
