datasource db {
  provider = "postgresql"
  url      = env("COMM_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  title       String
  message     String
  priority    String   @default("LOW") // "LOW", "MEDIUM", "HIGH"
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model WhatsAppMessage {
  id          String   @id @default(uuid())
  messageId   String?  @unique // Meta message ID (for status tracking)
  recipientId String?  // System user id if linked
  from        String   // From phone number
  to          String   // To phone number
  direction   String   // "INBOUND" or "OUTBOUND"
  type        String   // "text" | "button" | "template"
  body        String   // Message body/content or button payload
  status      String   // "sent", "delivered", "read", "received", "failed"
  error       String?  // Error message if failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

