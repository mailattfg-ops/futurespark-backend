datasource db {
  provider = "postgresql"
  url      = env("INTEGRATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

model IntegrationConfig {
  id           String   @id @default(uuid())
  providerName String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model GoogleAccount {
  id             String    @id @default(uuid())
  workspaceEmail String    @unique
  accessToken    String
  refreshToken   String
  tokenExpiry    DateTime
  connected      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ZoomAccount {
  id             String    @id @default(uuid())
  accountEmail   String    @unique
  accountType    String    @default("SERVER_TO_SERVER") // "SERVER_TO_SERVER" | "OAUTH"
  accountId      String?
  clientId       String?
  clientSecret   String?
  accessToken    String?
  refreshToken   String?
  tokenExpiry    DateTime?
  connected      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Meeting {
  id                 String             @id @default(uuid())
  provider           String             @default("GOOGLE_MEET") // "GOOGLE_MEET" | "ZOOM"
  calendarEventId    String?            @unique
  conferenceId       String?
  zoomMeetingId      String?            @unique
  zoomJoinUrl        String?
  zoomStartUrl       String?
  zoomPasscode       String?
  zoomHostEmail      String?
  meetUrl            String
  title              String
  description        String?
  organizerEmail     String
  teacherId          String
  studentId          String
  programId          String
  sessionId          String
  startTime          DateTime
  endTime            DateTime
  timezone           String
  status             String             @default("SCHEDULED") // "SCHEDULED", "ACTIVE", "COMPLETED", "CANCELLED"
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  recordings         MeetingRecording[]

  // ── Post-class recording hunt ────────────────────────────────────────────
  // Stamped by auth-service when the MENTOR marks the class complete. The Drive
  // sweep will not look for a recording until this is set and old enough (see
  // RECORDING_SEARCH_DELAY_MINUTES) — Google publishes a Meet recording to Drive
  // 10-30 minutes after the call ends, and searching before then is pure quota
  // burn: the old sweep asked Drive every 2 minutes for 48 hours per meeting.
  classCompletedAt    DateTime?
  // How many times the sweep has searched Drive for this meeting, so a class
  // that was genuinely never recorded gives up instead of retrying forever.
  recordingSearches   Int       @default(0)
  recordingSearchedAt DateTime?

  // ── Live presence (Google Meet spaces.activeConference or Zoom live status) ──
  presenceIsLive      Boolean   @default(false)
  presenceFirstJoinAt DateTime?
  presenceLastLiveAt  DateTime?
  presenceCheckedAt   DateTime?
}

model MeetingRecording {
  id                   String   @id @default(uuid())
  meetingId            String
  meeting              Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  driveFileId          String?  @unique
  zoomRecordingId      String?  @unique
  fileName             String
  fileSize             Int
  duration             Int?     // Duration in seconds
  downloadUrl          String?
  playUrl              String?
  videoPath            String?  // Local/storage path for download
  audioPath            String?  // Local/storage path for extracted audio
  downloadStatus       String   @default("PENDING") // "PENDING", "COMPLETED", "FAILED"
  extractedAudioStatus String   @default("PENDING") // "PENDING", "COMPLETED", "FAILED"
  createdAt            DateTime @default(now())
}
