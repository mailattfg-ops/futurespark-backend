{
  "name": "@futurespark/integration-service",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma db push --accept-data-loss && prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@futurespark/constants": "*",
    "@futurespark/database": "*",
    "@futurespark/logger": "*",
    "@futurespark/response": "*",
    "@futurespark/storage": "*",
    "@prisma/client": "^5.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^173.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "prisma": "^5.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "@types/multer": "^1.4.11"
  }
}
