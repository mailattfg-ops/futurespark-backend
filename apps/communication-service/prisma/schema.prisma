datasource db {
  provider = "postgresql"
  url      = env("COMM_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  title       String
  message     String
  priority    String   @default("LOW") // "LOW", "MEDIUM", "HIGH"
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}
