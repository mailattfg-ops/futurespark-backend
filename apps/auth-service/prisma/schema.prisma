datasource db {
  provider          = "postgresql"
  url               = env("AUTH_DATABASE_URL")
  directUrl         = env("AUTH_DATABASE_URL")
  schemas           = ["auth", "learning"]
}

generator client {
  provider        = "prisma-client-js"
  output          = "./client"
  previewFeatures = ["multiSchema"]
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String            @default("")
  firstName         String?
  lastName          String?
  avatarUrl         String?
  roleId            String?
  role              Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive          Boolean           @default(true)
  requiresFtlReset  Boolean           @default(false)
  lastLoginAt       DateTime?
  qualifiedPrograms String[]          @default([]) // Program IDs qualified to teach
  mentorTypes       String[]          @default(["REGULAR"]) // "REGULAR", "DEMO"
  qualifications    String?
  experience        String?
  state             String?
  country           String?
  availabilityMode  String            @default("FIXED") // "FIXED" = only the weekly slots below, "FLEXIBLE" = open to any slot, "UNAVAILABLE" = not taking classes
  availabilityNote  String?           // Free-text caveat shown to schedulers, e.g. "prefer mornings IST"
  availabilityUpdatedAt DateTime?
  timezone          String            @default("Asia/Kolkata") // IANA timezone e.g. "America/New_York"
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  refreshTokens     RefreshToken[]
  mentorSchedules   MentorSchedule[]
  scheduledClasses  ScheduledClass[]  @relation("MentorClasses")
  scheduledByClasses ScheduledClass[]  @relation("ScheduledByUser")
  warningCount      Int               @default(0)
  warnings          String[]          @default([])
  schedulerGroupId  String?
  schedulerGroup    SchedulerGroup?   @relation("GroupMentors", fields: [schedulerGroupId], references: [id], onDelete: SetNull)
  managedGroups     SchedulerGroup[]  @relation("AssignedScheduler")

  @@schema("auth")
}

model MentorSchedule {
  id           String   @id @default(uuid())
  mentorId     String
  mentor       User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  weekday      Int      // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  startTime    String   // "HH:MM" 24-hr format
  endTime      String   // auto-calculated: startTime + 90 min
  scheduleType String   @default("REGULAR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("auth")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "ADMIN", "TEACHER", etc.
  description String?
  permissions String[] @default([]) // Checked permission keys list
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("auth")
}

model RefreshToken {
  id               String         @id @default(uuid())
  token            String         @unique
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentAccountId  String?
  parentAccount    ParentAccount? @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  studentId        String?
  student          Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  createdAt        DateTime       @default(now())

  @@schema("auth")
}

model ParentAccount {
  id                   String          @id @default(uuid())
  email                String          @unique
  passwordHash         String
  avatarUrl            String?
  isActive             Boolean         @default(true)
  requiresFtlReset     Boolean         @default(false)
  profiles             ParentProfile[]
  students             Student[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  refreshTokens        RefreshToken[]
  programId            String?
  program              Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  paymentApproved      Boolean         @default(false)
  selectedPlanType     String?         // "FULL" or "INSTALLMENT"
  paidInstallmentIds   String[]        @default([]) // IDs of paid installments
  warningCount         Int             @default(0)
  warnings             String[]        @default([])

  @@schema("auth")
}

model ParentProfile {
  id              String        @id @default(uuid())
  parentAccountId String
  parentAccount   ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  phone           String?
  relationship    String?       // e.g. "Mother", "Father", "Guardian"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@schema("auth")
}

/// One child signed up to one programme, with the money for it.
///
/// Enrolment used to live on ParentAccount: a single `programId` and a single
/// `paymentApproved` for the whole family. That could not express two siblings
/// on different programmes, or one child taking two — and changing the field
/// silently voided a payment the family had already made.
///
/// Payment belongs on the enrolment because that is what is bought. The old
/// ParentAccount and Student payment columns are left in place and still read
/// as a fallback, so families created before this keep working untouched.
model Enrollment {
  id                 String   @id @default(uuid())
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId          String
  program            Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  paymentApproved    Boolean  @default(false)
  /// "FULL" | "INSTALLMENT"
  selectedPlanType   String?
  paidInstallmentIds String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  /// A child cannot be enrolled in the same programme twice. This is also what
  /// makes "add programme" idempotent under a double-submit.
  @@unique([studentId, programId])
  @@index([programId])
  @@schema("auth")
}

model Student {
  id               String           @id @default(uuid())
  studentCode      String?          @unique
  parentAccountId  String
  parentAccount    ParentAccount    @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  email            String           @unique
  passwordHash     String
  firstName        String
  lastName         String
  avatarUrl        String?
  isActive         Boolean          @default(true)
  requiresFtlReset Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  refreshTokens    RefreshToken[]
  scheduledClasses ScheduledClass[]
  paymentApproved  Boolean          @default(false)
  warningCount     Int              @default(0)
  warnings         String[]         @default([])
  credits          Int              @default(0)
  timezone         String           @default("Asia/Kolkata") // IANA timezone e.g. "America/New_York"
  schedulerGroupId String?
  schedulerGroup   SchedulerGroup?  @relation("GroupStudents", fields: [schedulerGroupId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]

  @@schema("auth")
}

model SchedulerGroup {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String?
  maxMentors   Int       @default(50)
  maxStudents  Int       @default(100)
  schedulerId  String?
  scheduler    User?     @relation("AssignedScheduler", fields: [schedulerId], references: [id], onDelete: SetNull)
  mentors      User[]    @relation("GroupMentors")
  students     Student[] @relation("GroupStudents")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@schema("auth")
}

model ScheduledClass {
  id              String    @id @default(uuid())
  studentId       String?
  student         Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId        String?
  mentor          User?     @relation("MentorClasses", fields: [mentorId], references: [id], onDelete: SetNull)
  scheduledById   String?   // Staff User ID who created this booking
  scheduledBy     User?     @relation("ScheduledByUser", fields: [scheduledById], references: [id], onDelete: SetNull)
  programId       String?   // Program UUID from learning service
  sessionId       String?   // Session UUID from learning service
  startTime       DateTime  @default(now())
  endTime         DateTime  @default(now())
  status          String    @default("SCHEDULED") // "SCHEDULED", "COMPLETED", "CANCELLED"
  classType       String    @default("REGULAR")   // "REGULAR", "DEMO"
  leadId            String?   // Lead UUID if classType is DEMO
  meetingLink       String?   // Optional Google Meet / Zoom / video call URL
  rescheduleReason  String?
  rescheduleMessage String?
  qaStatus          String    @default("PENDING")   // "PENDING", "PASSED", "FAILED", "FLAGGED"
  qaFeedback        String?
  reports           SessionReport[]
  creditsAwarded    Int?
  studentRating     Int?
  studentFeedback   String?
  reflectionAnswers     Json?
  reflectionSubmittedAt DateTime?
  reflectionScore       Int?
  reflectionMaxScore    Int?
  reflectionBadge       String?   // "GOLD" | "SILVER" | "BRONZE"
  // Mentor sign-off on the submitted quiz. Grading is automatic, but a score
  // alone does not tell a parent whether the mentor actually read the answers —
  // these do, and the note is where the mentor replies to what the student wrote.
  reflectionReviewedAt   DateTime?
  reflectionReviewedById String?
  reflectionMentorNote   String?   @db.Text
  rescheduledCount    Int       @default(0)
  actualEndedAt       DateTime?
  autoRecording       Boolean   @default(true)
  recordingUrl        String?
  transcript          String?   @db.Text
  classSummary        String?   @db.Text
  interactionMetrics  Json?
  transcriptionStatus String    @default("NOT_STARTED")

  // ── Post-class parent report ──────────────────────────────────────────
  // `completedAt` is the moment the mentor pressed "Completed", and it is the
  // only anchor the recording hunt may use. `updatedAt` moves on every write,
  // and `endTime` is when the slot was *booked* to end rather than when the
  // class was signed off — a mentor who marks a class complete the next
  // morning would otherwise have the search window expire before it ran.
  completedAt         DateTime?
  reportPdfPath       String?   // S3 key (or local path) of the rendered PDF
  reportSentAt        DateTime? // Meta accepted the WhatsApp report — the idempotency latch
  reportAttempts      Int       @default(0)
  reportLastError     String?   @db.Text
  doubts              ClassDoubt[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@schema("auth")
}

/// A question the student had after a class, and the mentor's reply.
///
/// Deliberately tied to a class rather than free-floating: "I didn't follow the
/// compound-interest bit" is only answerable if the mentor knows which lesson it
/// came from, and it gives the mentor the recording and the quiz answers as
/// context when they sit down to reply.
model ClassDoubt {
  id             String         @id @default(uuid())
  classId        String
  class          ScheduledClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId      String
  question       String         @db.Text
  /// "OPEN" until a mentor replies, then "ANSWERED".
  status         String         @default("OPEN")
  answer         String?        @db.Text
  answeredAt     DateTime?
  answeredById   String?
  answeredByName String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  @@index([classId])
  @@index([studentId])
  @@index([status])
  @@schema("auth")
}

model SessionReport {
  id           String         @id @default(uuid())
  classId      String
  class        ScheduledClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  reporterId   String
  reporterRole String
  reporterName String
  issueType    String
  description  String
  status       String         @default("OPEN") // "OPEN", "INVESTIGATING", "RESOLVED"
  qaFeedback   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@schema("auth")
}

// ── Models from learning schema (read-only in auth context but mapped for relation consistency) ──

enum PlanType {
  FULL
  INSTALLMENT
  @@schema("learning")
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO_SCHEDULED
  ADMISSION_PENDING
  PAYMENT_SUBMITTED
  ENROLLED
  LOST
  @@schema("learning")
}

model Program {
  id             String          @id @default(uuid())
  title          String
  description    String?
  level          String          @default("Beginner")
  levelColor     String          @default("purple")
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  paymentPlans   PaymentPlan[]
  leads          Lead[]
  parentAccounts ParentAccount[]
  enrollments    Enrollment[]

  @@schema("learning")
}

model PaymentPlan {
  id           String        @id @default(uuid())
  type         PlanType
  price        Float         @default(0.0)
  description  String?
  programId    String
  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  installments Installment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([programId, type])
  @@schema("learning")
}

model Installment {
  id            String      @id @default(uuid())
  name          String
  amount        Float
  order         Int
  paymentPlanId String
  paymentPlan   PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  sessions      Session[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@schema("learning")
}

model Session {
  id            String       @id @default(uuid())
  title         String
  order         Int
  durationMin   Int          @default(60)
  slidesUrl     String?
  guideUrl      String?
  worksheetUrl  String?
  programId     String?
  program       Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  credits       Int          @default(10)
  // Post-class reflection prompts the student answers before the next class.
  // Empty means "not customised" — readers fall back to the platform defaults.
  reflectionQuestions String[] @default([])
  // The typed quiz that supersedes the plain prompts above. Shape:
  // ReflectionQuestion[] from @futurespark/constants. Null/empty means the
  // session has no custom quiz and readers fall back to the prompts, then to
  // the platform defaults.
  reflectionQuiz Json?
  // Mind map of what this session covers. Shape: SessionTopic[].
  topics        Json?
  resources     SessionResource[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@schema("learning")
}

/// Mentor-contributed teaching aids for a curriculum session. Owned by
/// learning-service; mirrored here because this schema is the one that runs
/// `prisma db push`, and a model missing from it would be dropped from the DB.
model SessionResource {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  url         String
  kind        String   @default("LINK")
  topic       String?
  addedById   String
  addedByName String
  addedByRole String   @default("TEACHER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionId])
  @@schema("learning")
}

model Lead {
  id                  String     @id @default(uuid())
  /// The PARENT — the person who fills in the enquiry, takes the calls and
  /// receives the demo report.
  firstName           String
  lastName            String
  email               String
  phone               String?
  /// The CHILD who will actually attend.
  ///
  /// One name used to stand for both people, so a demo class, the mentor's
  /// timetable and the demo report all showed the parent where the child
  /// belonged. Nullable because every lead created before this has a single
  /// name and there is no way to tell which of the two it referred to —
  /// readers fall back to the parent name rather than showing a blank.
  studentFirstName    String?
  studentLastName     String?
  source              String     @default("Website")
  status              LeadStatus @default(NEW)
  programId           String?
  program             Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  notes               String?
  demoClass           Boolean    @default(false)
  assignedAdvisorId   String?
  preferredDays       String[]   @default([])
  preferredTime       String?
  preferredTimezone   String?    @default("Asia/Kolkata")
  paymentAmount       Float?
  paymentTxnRef       String?
  paymentMethod       String?
  paymentStatus       String?    @default("NONE")
  paymentVerifiedBy   String?
  paymentVerifiedAt   DateTime?
  telecallerNotes     String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@schema("learning")
}
