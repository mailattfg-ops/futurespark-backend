# Dependency directories
node_modules/

# Build outputs
dist/
.next/
out/

# Environment files — ALL of them, with no exceptions.
# There was an `!.env.example` un-ignore here for a committed placeholder
# template. It was removed along with the file: with no exception rule, any
# .env* that appears in future is ignored by default, so a real credential
# cannot be committed by pasting it into a file that looked like a template.
.env
.env.local
.env.*

# Local downloaded media recordings cache
downloads/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Prisma generated clients
**/prisma/client/

logs/
