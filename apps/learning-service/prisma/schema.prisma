datasource db {
  provider          = "postgresql"
  url               = env("LEARN_DATABASE_URL")
  schemas           = ["auth", "learning"]
}

generator client {
  provider        = "prisma-client-js"
  output          = "./client"
  previewFeatures = ["multiSchema"]
}

enum PlanType {
  FULL
  INSTALLMENT

  @@schema("learning")
}

model Program {
  id           String        @id @default(uuid())
  title        String
  description  String?
  level        String        @default("Beginner")
  levelColor   String        @default("purple")
  image        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  paymentPlans PaymentPlan[]
  leads        Lead[]

  @@schema("learning")
}

model PaymentPlan {
  id           String        @id @default(uuid())
  type         PlanType
  price        Float         @default(0.0)
  description  String?
  programId    String
  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  installments Installment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([programId, type])
  @@schema("learning")
}

model Installment {
  id            String      @id @default(uuid())
  name          String
  amount        Float
  order         Int
  paymentPlanId String
  paymentPlan   PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  sessions      Session[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@schema("learning")
}

model Session {
  id            String       @id @default(uuid())
  title         String
  order         Int
  durationMin   Int          @default(60)
  slidesUrl     String?
  guideUrl      String?
  worksheetUrl  String?
  programId     String?
  program       Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  credits       Int          @default(10)
  // Post-class reflection prompts the student answers before the next class.
  // Empty means "not customised" — readers fall back to the platform defaults.
  reflectionQuestions String[] @default([])
  // The typed quiz that supersedes the plain prompts above. Shape:
  // ReflectionQuestion[] from @futurespark/constants. Null/empty means the
  // session has no custom quiz and readers fall back to the prompts, then to
  // the platform defaults.
  reflectionQuiz Json?
  // Mind map of what this session covers. Shape: SessionTopic[].
  topics        Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@schema("learning")
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO_SCHEDULED
  ADMISSION_PENDING
  PAYMENT_SUBMITTED
  ENROLLED
  LOST

  @@schema("learning")
}

model Lead {
  id                  String     @id @default(uuid())
  firstName           String
  lastName            String
  email               String
  phone               String?
  source              String     @default("Website")
  status              LeadStatus @default(NEW)
  programId           String?
  program             Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  notes               String?
  demoClass           Boolean    @default(false)
  assignedAdvisorId   String?
  preferredDays       String[]   @default([])
  preferredTime       String?
  preferredTimezone   String?    @default("Asia/Kolkata")
  paymentAmount       Float?
  paymentTxnRef       String?
  paymentMethod       String?
  paymentStatus       String?    @default("NONE")
  paymentVerifiedBy   String?
  paymentVerifiedAt   DateTime?
  telecallerNotes     String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@schema("learning")
}

model ScheduledClass {
  id                  String   @id @default(uuid())
  meetingLink         String?
  transcript          String?  @db.Text
  classSummary        String?  @db.Text
  interactionMetrics  Json?
  transcriptionStatus String   @default("NOT_STARTED")
  reflectionAnswers     Json?
  reflectionSubmittedAt DateTime?
  reflectionScore       Int?
  reflectionMaxScore    Int?
  reflectionBadge       String?
  rescheduledCount      Int      @default(0)
  actualEndedAt         DateTime?

  @@schema("auth")
}
