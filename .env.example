###############################################################################
# FutureSpark backend — environment variable reference
#
# Derived by grepping `process.env.*` and Prisma `env("...")` across apps/ and
# packages/ (excluding node_modules/, dist/ and generated prisma/client/).
# Every value below is a PLACEHOLDER. No real credential appears in this file.
#
# Copy to `.env` at the repo root and fill in:   cp .env.example .env
#
# HOW LOADING WORKS
#   Each service's server.ts calls `dotenv.config({ path: <repo root>/.env })`
#   then `dotenv.config()`. One root .env feeds every service. dotenv never
#   overwrites an already-set variable, so real process env wins over the file.
#
# !! .gitignore LINE 12 IS `.env.*`, WHICH MATCHES `.env.example` ITSELF !!
#   This file is currently ignored by git and will NOT be committed. To ship it,
#   .gitignore needs an un-ignore line (`!.env.example`) — not done here because
#   .gitignore is outside this change's ownership.
#
# LEGEND
#   [REQUIRED]  the code cannot work correctly without it
#   [OPTIONAL]  code has a safe, non-secret default
#   [!! INSECURE FALLBACK !!]  the code substitutes a HARDCODED SECRET when the
#       variable is unset. The repo is PUBLIC, so those literals are published
#       and any deployment running without the variable set is using a secret
#       an attacker can read. See the summary at the bottom of this file.
###############################################################################


# =============================================================================
# 1. RUNTIME
# =============================================================================

# [OPTIONAL] Default: unset. 'development' turns on Prisma query logging in
#   every service's datasource.ts; 'production' makes the error middleware hide
#   exception messages (packages/middleware/src/index.ts) and makes the WhatsApp
#   startup check fatal instead of a warning.
#   Source: you. One of: development | production | test
NODE_ENV=development

# [OPTIONAL] Default: 'debug'. Pino level in packages/logger.
#   Source: you. One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# [OPTIONAL] Default: 3000. Gateway HTTP port (apps/gateway/src/server.ts).
#   NOTE: only the gateway reads bare PORT; every other service uses its own
#   <NAME>_SERVICE_PORT below.
PORT=3000


# =============================================================================
# 2. DATABASE  (PostgreSQL — one Prisma datasource per service)
#
# Each service owns a separate schema.prisma with its own env() name. They may
# all point at the same Postgres instance, but the variable names are distinct
# and a service will not boot on the wrong one.
#
# Source: your Postgres/Supabase/Neon connection string.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# =============================================================================

# [REQUIRED by auth-service]        apps/auth-service/prisma/schema.prisma
AUTH_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/futurespark_auth?schema=public

# [REQUIRED by learning-service]    apps/learning-service/prisma/schema.prisma
LEARN_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/futurespark_learn?schema=public

# [REQUIRED by payment-service]     apps/payment-service/prisma/schema.prisma
PAY_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/futurespark_pay?schema=public

# [REQUIRED by communication-service] apps/communication-service/prisma/schema.prisma
COMM_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/futurespark_comm?schema=public

# [REQUIRED by analytics-service]   apps/analytics-service/prisma/schema.prisma
ANALYTICS_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/futurespark_analytics?schema=public

# [REQUIRED by integration-service] apps/integration-service/prisma/schema.prisma
#   Holds Meeting, MeetingRecording, GoogleAccount, ZoomAccount.
INTEGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/futurespark_integration?schema=public

# [OPTIONAL] Default: 'redis://localhost:6379' (packages/cache/src/index.ts).
#   Backs JWT refresh-token storage and revocation. The default is fine locally
#   but MUST be set in production — pointing at a Redis that is not shared by
#   every service silently breaks logout/revocation.
#   Source: your Redis/Upstash URL.
REDIS_URL=redis://localhost:6379


# =============================================================================
# 3. AUTH & CRYPTO
#
# EVERY VARIABLE IN THIS SECTION MARKED [!! INSECURE FALLBACK !!] HAS A
# HARDCODED SECRET IN THE PUBLIC SOURCE. Set all four before any deployment.
#
# Generate each with:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# =============================================================================

# [REQUIRED] [!! INSECURE FALLBACK !!]
#   Signs and verifies user access JWTs. Also derives the class-media grant key
#   (packages/constants/src/index.ts:623) and the recording stream token
#   (apps/integration-service/.../google/recording/stream-token.ts:28) — so this
#   one value gates login AND direct video streaming.
#   Falls back to the published literal 'dev-access-secret-change-in-production'
#   at packages/authentication/src/index.ts:9. Anyone can forge a token.
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32

# [REQUIRED] [!! INSECURE FALLBACK !!]
#   Signs and verifies refresh JWTs (packages/authentication/src/index.ts:10).
#   Falls back to 'dev-refresh-secret-change-in-production'.
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32

# [REQUIRED] [!! INSECURE FALLBACK !!]
#   HMAC key for service-to-service internal request signing
#   (packages/authentication/src/index.ts:14). With the fallback in use, any
#   caller can mint a valid internal signature and bypass gateway auth.
#   Falls back to 'dev-internal-hmac-key-change-in-production'.
INTERNAL_HMAC_KEY=replace-with-openssl-rand-hex-32

# [REQUIRED] [!! INSECURE FALLBACK !!]
#   AES key encrypting Google and Zoom OAuth tokens at rest in the DB
#   (google/auth/auth.service.ts:8 and zoom/auth/auth.service.ts:6 — same key,
#   both services). Falls back to the published 32-byte literal
#   'default-secret-key-32-chars-long!', which makes every stored provider
#   token trivially decryptable by anyone with DB read access.
#   NOTE: the code does Buffer.concat([...], 32) — the value is truncated or
#   zero-padded to exactly 32 bytes, so supply a 32-character/32-byte key.
ENCRYPTION_KEY=replace-with-a-32-byte-key-000000

# [OPTIONAL] Default: '15m'. Access-token lifetime string passed to jsonwebtoken.
JWT_ACCESS_EXPIRY=15m

# [OPTIONAL] Default: '7d'. Refresh-token lifetime string.
JWT_REFRESH_EXPIRY=7d

# [OPTIONAL] Access-token TTL in seconds.
#   WARNING — TWO DIFFERENT DEFAULTS READ THE SAME NAME:
#     packages/authentication/src/index.ts:13   defaults to 900     (15 minutes)
#     apps/auth-service/.../auth.service.ts:19  defaults to 2592000 (30 days)
#   Leave it unset and the two disagree. Set it explicitly.
JWT_ACCESS_TTL_SECONDS=900

# [OPTIONAL] Default: 90. Refresh-token retention in days
#   (apps/auth-service/src/modules/auth/auth.service.ts:18).
JWT_REFRESH_TTL_DAYS=90


# =============================================================================
# 4. SERVICE PORTS  (all optional — each has a hardcoded default)
# =============================================================================

AUTH_SERVICE_PORT=3001           # [OPTIONAL] default 3001
LEARNING_SERVICE_PORT=3002       # [OPTIONAL] default 3002
COMMUNICATION_SERVICE_PORT=3003  # [OPTIONAL] default 3003
PAYMENT_SERVICE_PORT=3004        # [OPTIONAL] default 3004
ANALYTICS_SERVICE_PORT=3005      # [OPTIONAL] default 3005
INTEGRATION_SERVICE_PORT=3006    # [OPTIONAL] default 3006


# =============================================================================
# 5. SERVICE URLS  (inter-service HTTP calls + gateway proxy targets)
#
# All optional; every one defaults to localhost/127.0.0.1 on the port above.
# ALL OF THEM ARE REQUIRED IN ANY NON-LOCAL DEPLOYMENT — an unset value silently
# resolves to localhost and the call fails or, worse, hits the wrong container.
#
# Naming is inconsistent in the source and is NOT normalised here: two use the
# short form (LEARN_/PAY_) and two the long form (COMMUNICATION_/INTEGRATION_).
# There is no ANALYTICS_SERVICE_URL — nothing calls analytics over HTTP.
# =============================================================================

# [OPTIONAL] Gateway proxy target + called by integration-service (presence,
#   webhooks, recording controller) and learning-service and whatsapp.service.
#   Defaults: 'http://127.0.0.1:3001' (gateway) / 'http://localhost:3001' (rest)
AUTH_SERVICE_URL=http://127.0.0.1:3001

# [OPTIONAL] Gateway proxy target + integration-service posts transcription
#   jobs here (google/recording/recording.service.ts:537).
#   Defaults: 'http://127.0.0.1:3002' / 'http://localhost:3002'
LEARN_SERVICE_URL=http://127.0.0.1:3002

# [OPTIONAL] Gateway proxy target. Default 'http://127.0.0.1:3004'.
PAY_SERVICE_URL=http://127.0.0.1:3004

# [OPTIONAL] Gateway proxy target + auth-service notification-helper.
#   Defaults: 'http://127.0.0.1:3003' / 'http://localhost:3003'
COMMUNICATION_SERVICE_URL=http://127.0.0.1:3003

# [OPTIONAL] Gateway proxy target + auth-service calendar-helper.
#   Defaults: 'http://127.0.0.1:3006' / 'http://localhost:3006'
INTEGRATION_SERVICE_URL=http://127.0.0.1:3006

# NOTE: `LEARNING_SERVICE_URL` (long form) appears ONLY in a stale compiled
# artifact, apps/integration-service/dist/.../recording.controller.js:210, where
# it defaults to port 3003 — the communication-service port, which is a bug in
# that stale build. The TypeScript source uses LEARN_SERVICE_URL. Do not set the
# long form; rebuild dist/ instead.


# =============================================================================
# 6. GOOGLE (OAuth, Calendar/Meet, Drive)
# =============================================================================

# [REQUIRED for Google Meet + Drive] OAuth 2.0 client credentials.
#   Source: Google Cloud Console > APIs & Services > Credentials > OAuth client.
#   No fallback: google/auth/auth.service.ts throws when either is missing.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me

# [OPTIONAL] Default 'http://localhost:3000/api/google/callback'.
#   Must byte-match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# [OPTIONAL] Default ''. Last-resort refresh token used only when no
#   GoogleAccount row exists or the DB is unreachable
#   (google/auth/auth.service.ts:151). Normally tokens live encrypted in the DB;
#   set this only for a single-workspace bootstrap.
GOOGLE_REFRESH_TOKEN=

# ── Calendar API throttle / retry (google/calendar/calendar.service.ts) ──
GOOGLE_CALENDAR_MIN_INTERVAL_MS=150   # [OPTIONAL] default 150.  Min gap between Calendar calls.
GOOGLE_CALENDAR_MAX_PER_MINUTE=120    # [OPTIONAL] default 120.  Rolling 60s local budget.
GOOGLE_CALENDAR_BACKOFF_MS=2000       # [OPTIONAL] default 2000. Base for 2s/4s/8s exponential backoff.
GOOGLE_CALENDAR_MAX_ATTEMPTS=3        # [OPTIONAL] default 3.    Attempts per call, retries included.

# ── Meeting creation (google/meetings/meetings.service.ts) ──
# [OPTIONAL] Default: enabled. Set to exactly 'false' to mint a new Meet room
#   per session instead of reusing one room per mentor/student/programme triple.
GOOGLE_MEET_REUSE_PER_PROGRAM=true
# [OPTIONAL] default 120000. Prisma interactive-transaction timeout for the
#   booking transaction — it must outlast a throttled Calendar call plus backoff.
MEETING_CREATE_TIMEOUT_MS=120000
# [OPTIONAL] default 60000. Prisma maxWait for a connection on that transaction.
MEETING_CREATE_MAX_WAIT_MS=60000

# ── Meet live-presence polling (google/presence/presence.service.ts) ──
MEET_EMPTY_GRACE_MS=120000            # [OPTIONAL] default 120000 (2m). Empty-room grace before ending.
MEET_WATCH_AFTER_MS=3600000           # [OPTIONAL] default 3600000 (1h). How long past start to keep watching.
MEET_PRESENCE_POLL_MS=30000           # [OPTIONAL] default 30000 (30s). Poll interval.
MAX_CONCURRENT_PRESENCE_CALLS=4       # [OPTIONAL] default 4. Concurrent Meet presence lookups.


# =============================================================================
# 7. ZOOM
# =============================================================================

# [REQUIRED for Zoom] Server-to-Server OAuth app credentials. All three must be
#   present or ZoomAuthService reports the integration as not configured
#   (zoom/auth/auth.service.ts:300-302).
#   Source: Zoom App Marketplace > Develop > Build App > Server-to-Server OAuth.
ZOOM_ACCOUNT_ID=replace-with-zoom-account-id
ZOOM_CLIENT_ID=replace-with-zoom-client-id
ZOOM_CLIENT_SECRET=replace-with-zoom-client-secret

# [OPTIONAL] Default 'http://localhost:3000/api/zoom/callback'. Only used by the
#   user-level OAuth flow (zoom/auth/auth.service.ts:115,137); the S2S path
#   ignores it. Must match the redirect URL configured on the Zoom app.
ZOOM_REDIRECT_URI=http://localhost:3000/api/zoom/callback

# [REQUIRED] [!! INSECURE FALLBACK !!]
#   Verifies the x-zm-signature HMAC on inbound Zoom webhooks and answers the
#   endpoint URL validation challenge (zoom/webhooks/webhooks.service.ts:13).
#   Falls back to the published literal 'futurespark-zoom-webhook-secret' —
#   with that in place anyone can forge a recording.completed or
#   meeting.ended webhook against this backend.
#   Source: Zoom App Marketplace > your app > Feature > Secret Token.
ZOOM_WEBHOOK_SECRET_TOKEN=replace-with-zoom-webhook-secret-token

# ── Zoom seat pool / host assignment (NEW) ──
# These are the host-pool variables for the Zoom meeting path. They are read at
# meeting-create time and resolve which licensed Zoom user hosts each session;
# the chosen address is persisted on the existing Meeting.zoomHostEmail column.

# [OPTIONAL] Default: off unless set. Master switch for the Zoom provider. When
#   false/unset the platform books Google Meet only.
#   Values: true | false
ZOOM_ENABLED=false

# [REQUIRED when ZOOM_ENABLED=true] The seat pool: a comma-separated list of
#   licensed Zoom user emails that may be assigned as meeting host. One
#   concurrent meeting per seat, so the list length caps simultaneous classes.
#   Source: Zoom Admin > User Management > Users (Licensed users only; Basic
#   users cannot host >40min or cloud-record).
ZOOM_HOST_EMAILS=host1@example.com,host2@example.com

# [OPTIONAL] Default: false. When true, if the mentor's own email is a licensed
#   user in the Zoom account, prefer it as host before drawing from the pool.
#   Values: true | false
ZOOM_PREFER_MENTOR_HOST=false

# [OPTIONAL] Default: TRUE (zoom/auth/auth.service.ts:170). Sets Zoom's
#   join_before_host on created meetings.
#
#   Do NOT set this to false while the pool hosts your classes. A pool seat is
#   an unattended service account — no human ever signs into it — and Zoom makes
#   join_before_host and waiting_room mutually exclusive, so false puts every
#   class behind a waiting room with nobody on the inside to admit anyone. The
#   room becomes a locked door. The service logs this exact combination as a
#   config warning at startup (getZoomConfigWarnings).
#
#   The honest tradeoff for leaving it true: there is no waiting room, so a
#   student and mentor can be in the room unsupervised and anyone holding the
#   link (plus passcode, where account policy issues one) can walk in. On a
#   minors-facing platform that is a real safeguarding gap, mitigated only by
#   the link not being public and by the cloud recording.
#
#   Only set false when a licensed HUMAN is genuinely the host — i.e.
#   ZOOM_PREFER_MENTOR_HOST=true and your mentors are licensed Zoom users.
#   Values: true | false
ZOOM_JOIN_BEFORE_HOST=true

# [OPTIONAL] Default 'zoom@meet.futurespark.com' (auth.service.ts:179). Recorded
#   as Meeting.organizerEmail and used to pick the fallback credential. This is
#   NOT the host — the host is the allocated seat. The built-in default is a
#   futurespark.com address; set this explicitly so bookings are not attributed
#   to an address that does not exist on your Zoom account.
ZOOM_ORGANIZER_EMAIL=zoom@your-domain.com

# [OPTIONAL] Default 3, range 1-25. How many seats one booking may try before it
#   gives up. Only host-specific Zoom rejections (unlicensed / unknown / not on
#   this account) advance to the next seat; a generic API failure stops at once.
ZOOM_MAX_HOST_ATTEMPTS=3

# [OPTIONAL] Default 30, range 1-365. How far back the least-recently-used seat
#   ordering looks. Bounds the allocation query so it stays a small aggregate
#   instead of scanning every Zoom meeting ever booked.
ZOOM_HOST_LRU_WINDOW_DAYS=30

# ── Zoom API rate budget (auth.service.ts — the callZoom doorway) ──
# Zoom rate-limits per account AND caps meeting creations per user per day (100
# on most plans). Every Zoom call in the service funnels through one queue that
# applies these. Defaults are sane; raise only with a reason.
ZOOM_API_MIN_INTERVAL_MS=200           # [OPTIONAL] default 200, range 0-60000. Spacing between calls.
ZOOM_API_MAX_PER_MINUTE=60             # [OPTIONAL] default 60, range 1-10000. Rolling per-minute cap.
ZOOM_API_BACKOFF_MS=2000               # [OPTIONAL] default 2000, range 100-120000. Base for 2s/4s/8s backoff.
ZOOM_API_MAX_ATTEMPTS=3                # [OPTIONAL] default 3, range 1-10. Attempts per call.
ZOOM_API_TIMEOUT_MS=20000              # [OPTIONAL] default 20000, range 1000-120000. Per-request socket timeout.

# ── Zoom live-presence polling (zoom/presence/presence.service.ts) ──
ZOOM_EMPTY_GRACE_MS=120000            # [OPTIONAL] default 120000 (2m).
ZOOM_WATCH_AFTER_MS=3600000           # [OPTIONAL] default 3600000 (1h).
ZOOM_PRESENCE_POLL_MS=30000           # [OPTIONAL] default 30000 (30s).
MAX_CONCURRENT_ZOOM_CALLS=4           # [OPTIONAL] default 4. Concurrent Zoom presence lookups.


# =============================================================================
# 8. WHATSAPP  (Meta Graph API — communication-service)
#
# This module has NO fallback credentials by design: assertWhatsAppStartupConfig
# fails loudly when a required value is missing. It also hard-rejects two known
# burned values (see the security summary at the bottom).
# =============================================================================

# [REQUIRED] Graph API access token for the WhatsApp Business phone number.
#   Source: Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxREPLACE_ME

# [REQUIRED] The phone number ID that sends messages.
#   Source: Meta for Developers > WhatsApp > API Setup > "Phone number ID".
#   The sandbox/test number ID is rejected at boot — use a production number.
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# [REQUIRED] Meta App Secret. Verifies the X-Hub-Signature-256 HMAC on inbound
#   webhooks; the webhook POST route refuses to run without it.
#   Source: Meta for Developers > App settings > Basic > App secret.
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# [REQUIRED] Token echoed back during Meta's webhook GET verification handshake.
#   Must match the "Verify token" entered in the Meta webhook configuration.
#   Pick a fresh random string — the previously used value is burned.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-fresh-random-verify-token

# [OPTIONAL] Default 'v23.0'. Graph API version; must match /^v\d+\.\d+$/ or the
#   default is used and an error is logged.
WHATSAPP_API_VERSION=v23.0

# [OPTIONAL] Default 10000. Per-request timeout, clamped to 1000-60000.
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# [OPTIONAL] Default 3600000 (1h). Margin subtracted from Meta's 24h customer
#   service window before treating it as still open. Clamped to 0-43200000.
WHATSAPP_WINDOW_SAFETY_MARGIN_MS=3600000

# [OPTIONAL] Default: unset (no country code is ever inferred). Digits only, no
#   '+', 1-4 digits. Used to normalise local phone numbers on file.
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ── Business-initiated template (needed to message outside the 24h window) ──
WHATSAPP_NOTIFICATION_TEMPLATE_NAME=      # [OPTIONAL] Approved template name from Meta > WhatsApp Manager.
WHATSAPP_NOTIFICATION_TEMPLATE_LANGUAGE=  # [OPTIONAL] Template language code, e.g. en_US.
WHATSAPP_NOTIFICATION_TEMPLATE_PARAM_COUNT=2  # [OPTIONAL] default 2. Body variables the template declares: 1 or 2.

# ── Auto-reply content (substituted into outbound replies) ──
WHATSAPP_AUTOREPLY_ENABLED=true           # [OPTIONAL] default true. Set exactly 'false' to disable auto-replies.
WHATSAPP_BRAND_NAME=FutureSpark           # [OPTIONAL] default 'FutureSpark'.
WHATSAPP_BUSINESS_HOURS=                  # [OPTIONAL] free text, e.g. 'Mon-Sat 9am-7pm IST'.
WHATSAPP_CONTACT_PHONE=                   # [OPTIONAL] shown in auto-replies.
WHATSAPP_CONTACT_EMAIL=                   # [OPTIONAL] shown in auto-replies.
WHATSAPP_CONTACT_WEBSITE=                 # [OPTIONAL] shown in auto-replies.
WHATSAPP_LOCATION_ADDRESS=                # [OPTIONAL] shown in auto-replies.
WHATSAPP_LOCATION_MAPS_URL=               # [OPTIONAL] shown in auto-replies.

# ── Notification dispatch (communication-service notification module) ──
# [OPTIONAL] Default 'ADMIN'. Comma-separated roles allowed to POST
#   /notifications. Case-insensitive; empty falls back to ADMIN only.
NOTIFICATION_CREATE_ROLES=ADMIN
# [OPTIONAL] Default: synchronous. Set to exactly 'async' for fire-and-forget
#   WhatsApp delivery — the caller then stops seeing send failures.
NOTIFICATION_WHATSAPP_MODE=
# [OPTIONAL] Default 8000. Deadline for the WhatsApp leg of a notification,
#   clamped to 1000-60000.
NOTIFICATION_WHATSAPP_TIMEOUT_MS=8000


# =============================================================================
# 9. STORAGE  (AWS S3 — packages/storage; recordings, audio, transcripts)
#
# All optional: with credentials or bucket missing, S3Storage logs the gap and
# falls back to local disk. That fallback is not durable — set these in prod.
# Source: AWS IAM user with s3:PutObject/GetObject/DeleteObject on the bucket.
# =============================================================================

AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX          # [OPTIONAL] IAM access key id.
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret   # [OPTIONAL] IAM secret access key.
AWS_S3_BUCKET_NAME=futurespark-media            # [OPTIONAL] Preferred bucket name variable.
AWS_BUCKET_NAME=                                # [OPTIONAL] Legacy alias, used only when AWS_S3_BUCKET_NAME is unset. Prefer the name above.
AWS_REGION=us-east-1                            # [OPTIONAL] default 'us-east-1'.

# ── Media pipeline concurrency (google + zoom recording services) ──
MAX_CONCURRENT_DOWNLOADS=3   # [OPTIONAL] default 3. Simultaneous recording downloads.
MAX_CONCURRENT_FFMPEG=2      # [OPTIONAL] default 2. Simultaneous ffmpeg audio extractions.


# =============================================================================
# 10. AI
# =============================================================================

# [REQUIRED for transcription + AI summaries] Groq API key used by
#   learning-service (groq-transcription.service.ts). Defaults to '' — the
#   service boots and logs "GROQ_API_KEY MISSING", then every transcription
#   fails at call time rather than at startup.
#   Source: https://console.groq.com > API Keys.
GROQ_API_KEY=gsk_your_groq_api_key_here


###############################################################################
# SECURITY SUMMARY — HARDCODED FALLBACKS IN A PUBLIC REPO
#
# These five variables have a literal secret baked into the source that is used
# whenever the variable is unset. Because the repository is public, each literal
# is already disclosed. Any environment running without these set is
# compromised by default; rotating the variable is necessary but not sufficient
# — the fallbacks should be deleted from the source so a missing value fails
# loudly instead of silently downgrading to a published secret.
#
#   JWT_ACCESS_SECRET          packages/authentication/src/index.ts:9
#                              (also packages/constants/src/index.ts:623 and
#                               integration-service .../recording/stream-token.ts:28)
#   JWT_REFRESH_SECRET         packages/authentication/src/index.ts:10
#   INTERNAL_HMAC_KEY          packages/authentication/src/index.ts:14
#   ENCRYPTION_KEY             integration-service google/auth/auth.service.ts:6-8
#                              and zoom/auth/auth.service.ts:6
#   ZOOM_WEBHOOK_SECRET_TOKEN  integration-service zoom/webhooks/webhooks.service.ts:13
#
# Impact, in order of severity:
#   INTERNAL_HMAC_KEY    forge internal service-to-service auth; bypass gateway.
#   JWT_ACCESS_SECRET    forge any user's access token; also unlocks class-media
#                        grants and recording stream tokens.
#   JWT_REFRESH_SECRET   mint refresh tokens; persistent account access.
#   ENCRYPTION_KEY       decrypt every stored Google/Zoom OAuth token at rest.
#   ZOOM_WEBHOOK_SECRET_TOKEN  forge inbound Zoom webhooks.
#
# Not a fallback, but adjacent — two burned literals the WhatsApp module now
# hard-rejects at startup (communication-service .../whatsapp.service.ts:29-31):
#   the sandbox phone number id, and the previously committed webhook verify
#   token 'futurespark-webhook-secret'. Do not reuse either value.
#
# Non-secret hardcoded defaults worth knowing about (not exposures, but they
# make a misconfiguration look healthy):
#   GOOGLE_REFRESH_TOKEN unset -> '' (auth client with no credentials)
#   GROQ_API_KEY unset         -> '' (fails per-request, not at boot)
#   every *_SERVICE_URL unset  -> localhost (wrong target in a container)
#   integration-service google/recording/recording.service.ts:56-62 fabricates a
#     hardcoded organizerEmail + Meet URL when the meeting row is missing.
###############################################################################
